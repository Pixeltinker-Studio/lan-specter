# Copy to /etc/default/specter after choosing and wiring the physical GPIO pin.
# BCM numbering is used. GPIO18 is an example, not an automatic default.
SPECTER_BEEPER_PIN=18
SPECTER_BEEPER_MUTED=0
GPIOZERO_PIN_FACTORY=lgpio

# External Internet speed test. Install the matching librespeed-cli release first.
SPECTER_LIBRESPEED_BINARY=/usr/local/bin/librespeed-cli
SPECTER_LIBRESPEED_DURATION=10
SPECTER_LIBRESPEED_HTTP_TIMEOUT=15
SPECTER_LIBRESPEED_PROCESS_TIMEOUT=60
SPECTER_LIBRESPEED_SECURE=1

# Optional interface and backend selection. Leave blank for automatic interface
# selection and the public LibreSpeed.org server pool.
SPECTER_LIBRESPEED_INTERFACE=
SPECTER_LIBRESPEED_SERVER_ID=
SPECTER_LIBRESPEED_SERVER_JSON=
SPECTER_LIBRESPEED_LOCAL_JSON=
